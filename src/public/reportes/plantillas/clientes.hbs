<html>
  <head>
    <meta charset='UTF-8' />
    <title>Reorte De Clientes</title>
    <style type='text/css'>
      @font-face {
        font-family: 'Roboto';
        src: url('../../fonts/arial.ttf');
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: 'Arial', sans-serif;
      }

      .datos_emp_fecha {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        grid-template-areas: 'logo title title' 'logo fecha_hora fecha_hora';
        justify-content: center;
        align-items: center;
        text-align: center;
        font-size: 14px;
        letter-spacing: -0.1;
      }

      .logo {
        grid-area: logo;
      }

      .titulo {
        grid-area: title;
      }

      .fecha_hora {
        grid-area: fecha_hora;
      }

      .logo img {
        width: 85%;
      }

      table {
        width: 100%;
      }

      table thead tr.tcdv_tr_grid,
      table tbody tr.tcdv_tr_grid {
        display: grid;
        grid-template-columns: 20% 20% 20% 20% 20%;
        justify-content: center;
        align-items: center;
        text-align: center;
        font-size: 10px;
        letter-spacing: -0.1;
        border: 1px solid rgba(235, 235, 235, 1);
        padding: 5px 0;
      }

      .m_inicial {
        text-transform: capitalize;
      }
    </style>
  </head>
  <body>
    {{#each data_fechas}}
      <div class='datos_emp_fecha'>
        <div class='logo'>
          <img
            src='data:image/jpg;base64,'
          />
        </div>
        <div class='titulo'>
          <h3>Reporte de clientes</h3>
        </div>
        <div class='fecha_a'>
          <h5>Fecha:</h5>
          <h3>{{this.fecha_creado}}</h3>
        </div>
        <div class='fecha_c'>
          <h5>Creado por:</h5>
          <h3>{{this.user_creado}}</h3>
        </div>
      </div>
    {{/each}}
    <br />
    <br />
    <table>
      <thead>
        <tr class='tcdv_tr_grid'>
          <th>Codigo</th>
          <th>Nombre</th>
          <th>Teléfono</th>
          <th>Fecha Nacimiento</th>
          <th>Fecha De Registro</th>
        </tr>
      </thead>
      <tbody>
        {{#each data_clientes}}
          <tr class='tcdv_tr_grid'>
            <td>{{this.codigo_cliente}}</td>
            <td class='m_inicial'>{{this.nombre_cliente}}</td>
            <td>{{this.tel_cliente}}</td>
            <td>{{dateFormat this.fnac_cliente 'DD-MM-YYYY'}}</td>
            <td>{{dateFormat this.fecha_registro 'DD-MM-YYYY'}}</td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </body>
</html>
