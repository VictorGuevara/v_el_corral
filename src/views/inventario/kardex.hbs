<div class='main_content'>
	<main>
		<!-- TITULO -->
		<section>
			<h1>Kardex</h1>
			<h3 class='ruta_system'>Administración / Registro de entradas y salidas de productos</h3>
		</section>
		<!-- SOLO TABLA -->
		<section class='vista_tabla'>
			<div class='tabla_datos'>
				<!-- BUSQUEDA Y ACCIONES -->
				<div class='content_search_datos'>
					<div>
						<button class='btn_reporte' id='bnt_gR_kardex'>¿Crear Reporte?</button>
					</div>

				</div>

				<!-- <form class="formne" action="/link/add" method="POST" autocomplete="off"> -->
				<form class='formne' autocomplete='off' id=''>
					<button type='submit' disabled class='none' aria-hidden='true'></button>
					<h4><i class='fa-regular fa-file-lines'></i> Datos del producto:</h4>
					<div class='input_grup_3'>
						<div class='input_group'>
							<input type='hidden' id='codigoProducto' />
							<label for='nombreProductoKardex'>Nombre del producto</label>
							<input
								class='Minicial'
								id='nombreProductoKardex'
								type='text'
								onkeyup='d_kardexProducto(this.value)'
								placeholder='*'
								list='lista_productos'
							/>
						</div>
						<datalist id='lista_productos'></datalist>
						<div class='input_group'>
							<label for='f_search_inicial_kardex'>Fecha Inicial:</label>
							<input id='f_search_inicial_kardex' type='date' placeholder='*' />
						</div>
						<div class='input_group'>
							<label for='f_search_final_kardex'>Fecha Final:</label>
							<input id='f_search_final_kardex' type='date' placeholder='*' />
						</div>
					</div>
					<div>
						<table class='table_link'>
							<thead>
								<tr class='text_center'>
									<th colspan='1'>Fecha Movimiento</th>
									<th colspan='1' class='Minicial'>Nompre P.</th>
									<th colspan='3'>Entrada/as</th>
									<th colspan='3'>Salida</th>
									<th colspan='3'>Existencias</th>
								</tr>
							</thead>
							<tbody id='tbody_table_kardex'>
								{{! Aqui se cargan desde JavaScript }}
							</tbody>
						</table>
					</div>
				</form>
			</div>
		</section>
	</main>
</div>
